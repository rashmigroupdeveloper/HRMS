// Payroll: what an employee is paid.
// The salary agreed in the offer is copied to the employee on the joining day (decided 2026-11-15) - so the employee's
// pay does not depend on the candidate record. Revisions (an increment, a promotion's hike, a correction) are asked as
// job changes and approved (job-changes.prisma, 2026-11-20); each approved one is a row from its day - the salary
// history. Pay runs (2026-11-26) take inputs and work out the days, earnings, deductions and net pay (stages 2-4,
// 2026-11-27); approval, payslips and payment follow in later stages.

// An employee's salary from a date on: the annual fixed CTC, the performance pay and the monthly breakup (lines).
// The first one is the offer's (offer letter Annexure-I), effective from the date of joining.
model EmployeeSalary {
  id                   Int      @id @default(autoincrement())
  employeeId           Int      @map("employee_id")
  // The day this salary applies from - the date of joining for the one copied from the offer
  effectiveFrom        DateTime @map("effective_from") @db.Date
  // Annual FIXED cost to company in whole units of the currency; the monthly lines add up to it / 12, to the paisa
  annualCtc            Int      @map("annual_ctc")
  // "Performance pay (Target Oriented Earnings)" per year, on top of the fixed CTC
  performancePayAnnual Int?     @map("performance_pay_annual")
  // ISO 4217, e.g. INR - an overseas salary can be in another currency
  currency             String   @default("INR") @db.Char(3)
  // why it changed (2026-11-20): the joining (from the offer), an increment, a promotion, a correction...
  reason               SalaryReason @default(JOINING)
  // the approved job change that set it (a correction later sets the same row again - the latest is kept; the change
  // history keeps the earlier)
  jobChangeRequestId   Int?     @map("job_change_request_id")
  // when it was approved and by whom (the last approver) - empty for the offer's
  approvedAt           DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById         Int?      @map("approved_by_id")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById          Int      @map("created_by_id")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById          Int      @map("updated_by_id")

  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines            EmployeeSalaryLine[]
  jobChangeRequest JobChangeRequest?    @relation(fields: [jobChangeRequestId], references: [id], onDelete: Restrict)
  // pay-run segments copied from it (stage 2)
  payrollSegments  PayrollRunSalarySegment[]

  @@unique([employeeId, effectiveFrom])
  @@index([jobChangeRequestId])
  @@map("employee_salaries")
}

// Why a salary row exists
enum SalaryReason {
  // the offer's, from the date of joining
  JOINING
  INCREMENT
  PROMOTION
  CONFIRMATION
  CORRECTION
  OTHER

  @@map("salary_reason")
}

// One line of a salary's monthly breakup: one amount per salary component (Basic, HRA, employer PF...)
model EmployeeSalaryLine {
  id                Int      @id @default(autoincrement())
  employeeSalaryId  Int      @map("employee_salary_id")
  salaryComponentId Int      @map("salary_component_id")
  // per month in the currency, to the paisa / cent (2 decimals - the user, 2026-11-24: a CTC that does not divide by 12)
  monthlyAmount     Decimal  @map("monthly_amount") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       Int      @map("created_by_id")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById       Int      @map("updated_by_id")

  employeeSalary  EmployeeSalary  @relation(fields: [employeeSalaryId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@unique([employeeSalaryId, salaryComponentId])
  @@index([salaryComponentId])
  @@map("employee_salary_lines")
}

// Regular monthly India payroll header, approved 2026-11-26. Captured attendance dates are historical
// facts, not recalculated from mutable cycle settings. No employee amounts or payment actions in Stage 1.
model PayrollRun {
  id Int @id @default(autoincrement())
  companyId Int @map("company_id")
  payMonth DateTime @map("pay_month") @db.Date
  attendanceFrom DateTime @map("attendance_from") @db.Date
  attendanceTo DateTime @map("attendance_to") @db.Date
  status PayrollRunStatus @default(DRAFT)
  // When and by whom the people + salary copy (PayrollRunEmployee and below) was last rebuilt from the employee records
  // (stage 2, approved 2026-11-26) - set when the draft is created and on each refresh; the screen sends back the value
  // it saw, so a stale screen cannot refresh over a newer copy. The copy rows are not in the change history (core/audit
  // SKIP_MODELS); this column is, so every refresh is recorded on the run.
  peopleRefreshedAt   DateTime? @map("people_refreshed_at") @db.Timestamptz(3)
  peopleRefreshedById Int?      @map("people_refreshed_by_id")
  // When and by whom the pay was last worked out ("Work out pay", stage 3, approved 2026-11-27): the days (PayrollRunDay)
  // taken from the locked attendance and the amounts (PayrollRunLine) worked out from them - empty until then, and
  // emptied again when the people copy is refreshed (the pay is then worked out again). The screen sends back the value it
  // saw. The day and result rows are not in the change history; this column is, so every time is recorded on the run.
  computedAt          DateTime? @map("computed_at") @db.Timestamptz(3)
  computedById        Int?      @map("computed_by_id")
  // Stage 5 (approved by the user 2026-11-27): the approval request it was last sent with (the approval service keeps
  // who sent it, when, and every decision); emptied never - a rejected or withdrawn run keeps it until it is sent again
  approvalRequestId   Int?      @unique @map("approval_request_id")
  // when and by whom it was finalised - the last approval; from then on nothing in the run changes (corrections come as
  // arrears in a later run, stage 7)
  finalisedAt         DateTime? @map("finalised_at") @db.Timestamptz(3)
  finalisedById       Int?      @map("finalised_by_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById Int @map("created_by_id")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById Int @map("updated_by_id")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // the people it pays (stage 2)
  employees PayrollRunEmployee[]
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)

  @@unique([companyId, payMonth])
  @@index([payMonth, id])
  @@map("payroll_runs")
}

// Where a run stands (stage 5, approved 2026-11-27): a DRAFT is worked on; "Send for approval" works its pay out once more
// and sends it (IN_APPROVAL - nothing changes); rejected or withdrawn it is a DRAFT again; on the last approval it is
// FINALISED and never changes. Payment states come with stage 6.
enum PayrollRunStatus {
  DRAFT
  IN_APPROVAL
  FINALISED

  @@map("payroll_run_status")
}

// --- Stage 2 (approved by the user 2026-11-26): who is in a run, the salary copy, the month's inputs ---
// A run keeps its own COPY of the salary and placement it was built from: EmployeeSalary rows and the latest
// EmployeeJobRecord row are corrected in place, so pointing at them would not record what the run used. The copy is
// rebuilt by the system (on creating the draft and on "Refresh from employee records" while it is a draft), so the three
// copy tables are kept out of the change history like attendance days (core/audit SKIP_MODELS); each refresh is recorded
// on PayrollRun (peopleRefreshedAt / ById). Inputs (PayrollInput) are people's decisions and stay recorded.

// One person in a pay run: the company pays them for at least one day of the run's period (every employment type,
// consultants included - the user, 2026-11-26).
model PayrollRunEmployee {
  id           Int      @id @default(autoincrement())
  payrollRunId Int      @map("payroll_run_id")
  employeeId   Int      @map("employee_id")
  // The code they had in this company in the period. Copied: a company transfer gives a new code and the job timeline's
  // latest row can be corrected. Printed on the register, payslip and bank file.
  employeeCode String   @map("employee_code")
  // Why their pay could not be worked out the last time "Work out pay" ran (stage 4, approved 2026-11-27) - empty when
  // it was; emptied with their lines when their inputs change. heldNote: the detail for HR ("No PF wage ceiling in
  // force on 26 Feb 2027").
  heldFor      PayHold[] @default([]) @map("held_for")
  heldNote     String?   @map("held_note")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  Int      @map("created_by_id")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById  Int      @map("updated_by_id")

  run      PayrollRun                @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  segments PayrollRunSalarySegment[]
  inputs   PayrollInput[]
  // each day of theirs in the run's period, paid or not (stage 3)
  days     PayrollRunDay[]
  // what the run worked out for them, per component (stage 3)
  lines    PayrollRunLine[]
  // the warnings about them acknowledged before sending (stage 5)
  acknowledgements PayrollRunAcknowledgement[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_run_employees")
}

// A stretch of days of one person in a run with one salary and one placement. A change of either inside the period
// (an increment, a transfer, a joining or leaving date) makes a new segment; segments of a person never overlap.
model PayrollRunSalarySegment {
  id                   Int               @id @default(autoincrement())
  payrollRunEmployeeId Int               @map("payroll_run_employee_id")
  // inside the run's period, both days included
  fromDate             DateTime          @map("from_date") @db.Date
  toDate               DateTime          @map("to_date") @db.Date
  // --- the placement, copied from the job timeline ---
  // the plant the salary cost is posted to (stage 6); the State for professional tax and LWF comes from workLocationId
  plantId              Int               @map("plant_id")
  departmentId         Int               @map("department_id")
  // the accounting entry (stage 6); optional on the employee today
  costCenterId         Int?              @map("cost_center_id")
  // where they work, copied from the job timeline: its State decides professional tax and LWF (stage 4, approved
  // 2026-11-27 - the stretch at the period's end counts); empty = the person is held
  workLocationId       Int?              @map("work_location_id")
  // eligibility rules (PF, ESIC, bonus, overtime) in later stages
  employmentType       EmploymentType    @map("employment_type")
  workforceCategory    WorkforceCategory @map("workforce_category")
  // --- the salary, copied from the salary history ---
  // where it came from (shown with its reason); emptied if that salary row is ever removed - the copy below stays
  employeeSalaryId     Int?              @map("employee_salary_id")
  // annual fixed CTC in whole units, as on the salary; empty = no salary in force on these days - an exception for HR
  annualCtc            Int?              @map("annual_ctc")
  // ISO 4217, as on the salary
  currency             String?           @db.Char(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById          Int               @map("created_by_id")
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById          Int               @map("updated_by_id")

  runEmployee    PayrollRunEmployee     @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Cascade)
  plant          Plant                  @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department     Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter     CostCenter?            @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  workLocation   WorkLocation?          @relation(fields: [workLocationId], references: [id], onDelete: Restrict)
  employeeSalary EmployeeSalary?        @relation(fields: [employeeSalaryId], references: [id], onDelete: SetNull)
  lines          PayrollRunSalaryLine[]

  @@unique([payrollRunEmployeeId, fromDate])
  @@index([plantId])
  @@index([departmentId])
  @@index([costCenterId])
  @@index([workLocationId])
  @@index([employeeSalaryId])
  @@map("payroll_run_salary_segments")
}

// One component of a segment's monthly breakup, copied from the salary's lines
model PayrollRunSalaryLine {
  id                Int      @id @default(autoincrement())
  segmentId         Int      @map("segment_id")
  salaryComponentId Int      @map("salary_component_id")
  // per month, to the paisa - as on the salary
  monthlyAmount     Decimal  @map("monthly_amount") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       Int      @map("created_by_id")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById       Int      @map("updated_by_id")

  segment         PayrollRunSalarySegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent         @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@unique([segmentId, salaryComponentId])
  @@index([salaryComponentId])
  @@map("payroll_run_salary_lines")
}

// One amount typed for a person in a run (an incentive, a canteen recovery...). Entered and changed only while the run
// is a draft, by someone with Payroll Edit covering the whole company, never for their own record (the user,
// 2026-11-26). No unique key: two incentives in one month are possible; the same person + component + amount twice
// gets a warning. The month it belongs to is the run's (an earlier month is a stage 7 correction).
model PayrollInput {
  id                   Int      @id @default(autoincrement())
  payrollRunEmployeeId Int      @map("payroll_run_employee_id")
  // a component marked "entered monthly"; its kind says earning or deduction
  salaryComponentId    Int      @map("salary_component_id")
  // more than 0, to the paisa
  amount               Decimal  @db.Decimal(12, 2)
  // why - required
  note                 String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById          Int      @map("created_by_id")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById          Int      @map("updated_by_id")

  runEmployee     PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Restrict)
  salaryComponent SalaryComponent    @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@index([payrollRunEmployeeId])
  @@index([salaryComponentId])
  @@map("payroll_inputs")
}

// --- Stage 3 (approved by the user 2026-11-27): which days each person is paid for, and what they earned ---
// The money rule (the user, 2026-11-27 - to be checked against a greytHR salary register in the parallel run, BACKLOG
// item 31): a day is worth the monthly amount / the days of the pay period; each worked-out line is rounded to the
// rupee; a component is cut for unpaid days unless it is marked otherwise (SalaryComponent.cutForUnpaidDays).

// What a half day is for pay. UNCLEAR is never guessed into paid or unpaid: it is listed for HR.
enum PayClass {
  PAID
  UNPAID
  // attendance has no day for it, or the half is "on leave" with no approved leave found
  UNCLEAR

  @@map("pay_class")
}

// One day of one person in a pay run: whether each half is paid, and what attendance said. The run's own COPY of the
// locked attendance - an attendance month can be opened again after a run is paid, and the run must still show what it
// paid for. Only the days the person is in the company (inside their segments) have a row. Rebuilt by the system each
// time the days are worked out, so it is kept out of the change history like attendance days (core/audit SKIP_MODELS -
// approved 2026-11-27); PayrollRun.computedAt / ById record each time.
// The rule (payroll/days/days.service.ts) follows attendance half by half, with no rule of its own on top: present, on
// duty, weekly off, holiday and paid leave are paid; absent, missed punch and leave without pay are unpaid. So an absent
// Saturday (first half worked, second half off) costs half a day (the user, 2026-11-27), as leave counts it.
model PayrollRunDay {
  id                   Int        @id @default(autoincrement())
  payrollRunEmployeeId Int        @map("payroll_run_employee_id")
  // a day of the run's period
  date                 DateTime   @db.Date
  // the pay class of each half - the payable days of stage 3 are counted from these
  firstHalf            PayClass   @map("first_half")
  secondHalf           PayClass   @map("second_half")
  // what attendance said of each half when the days were taken (why it is paid or not; shown per day and on the later
  // register) - empty: attendance had no day
  firstStatus          DayStatus? @map("first_status")
  secondStatus         DayStatus? @map("second_status")
  // the leave type's code when the half is on leave ("CL", "LWP") - copied: a type can be renamed
  firstLeaveCode       String?    @map("first_leave_code")
  secondLeaveCode      String?    @map("second_leave_code")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById          Int        @map("created_by_id")
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById          Int        @map("updated_by_id")

  runEmployee PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunEmployeeId, date])
  @@map("payroll_run_days")
}

// What a pay run worked out for one person and one component (approved by the user 2026-11-27): stage 3 writes the
// earnings - each earning of the salary copy for the days paid, and the earning inputs typed for the month - and stage 4
// adds the deductions and the employer contributions to the same table (never below zero: a migration CHECK). A person
// whose pay cannot be worked out is listed with why (PayrollRunEmployee.heldFor), never guessed: no rows when the earnings
// cannot be worked out (no salary on some days, days missing in attendance...), only the earning rows when the
// deductions cannot (the user, 2026-11-27: held people still show what they earned). Rebuilt by the
// system each time the pay is worked out, so kept out of the change history like the run's days (core/audit SKIP_MODELS -
// approved 2026-11-27); PayrollRun.computedAt / ById record each time. A change to the person's inputs removes their
// rows, so the run shows that their pay must be worked out again.
model PayrollRunLine {
  id                   Int      @id @default(autoincrement())
  payrollRunEmployeeId Int      @map("payroll_run_employee_id")
  salaryComponentId    Int      @map("salary_component_id")
  // to the paisa: a worked-out line is rounded to the rupee, an input keeps what was typed
  amount               Decimal  @db.Decimal(12, 2)
  // what a deduction or employer contribution was worked out on (stage 4, approved 2026-11-27): the PF / EPS / EDLI
  // wages, the ESI wages, the gross for professional tax, the projected taxable income for TDS - printed on the register
  // and the PF return (ECR); empty for earnings and typed amounts
  base                 Decimal? @db.Decimal(12, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById          Int      @map("created_by_id")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById          Int      @map("updated_by_id")

  runEmployee     PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent    @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@unique([payrollRunEmployeeId, salaryComponentId])
  @@index([salaryComponentId])
  @@map("payroll_run_lines")
}

// Why a person's pay is held in a run (stage 3 and 4) - never guessed, listed for HR
enum PayHold {
  // no days in the pay period any more (kept in the run only for their inputs)
  NOT_IN_PERIOD
  // days with no salary in force
  NO_SALARY
  // a salary in another currency than INR - an India run does not pay it
  OTHER_CURRENCY
  // days attendance has no answer for (records changed after the lock)
  DAYS_MISSING
  // a stretch with no work location - its State decides professional tax and LWF
  NO_WORK_LOCATION
  // a statutory rate or slab not in force (or the person's date of birth / gender a slab needs is missing)
  NO_RATE
  // a statutory amount with no salary component carrying it (Organization › Salary components)
  NO_COMPONENT
  // all deductions together above half of the wages (Code on Wages s.18)
  OVER_HALF
  // income tax needs a typed figure: old regime, a consultant, or income above the surcharge limit
  TAX_TO_TYPE

  @@map("pay_hold")
}

// --- Stage 4 (approved by the user 2026-11-27): deductions, employer contributions and net pay ---
// Rates are data (coding plan rule 5): every statutory rate, ceiling and slab is a dated row entered on Payroll ›
// Statutory settings by someone with Payroll Edit for every company, with the notification it comes from - nothing is
// seeded or written in code, and tests make up their own rows. A missing row never counts as zero: the person is held.

// One dated value of a statutory rate or limit (one list for the group). A change inside a pay period is split by
// days - e.g. the PF wage ceiling of 17 Sep 2026: the days before at the old ceiling, the days after at the new; the
// income-tax values go by tax year (the value in force on 1 April).
model StatutoryRate {
  id            Int                @id @default(autoincrement())
  parameter     StatutoryParameter
  effectiveFrom DateTime           @map("effective_from") @db.Date
  // a percentage (12, 8.33, 0.75), an amount in rupees (25,000 a month; 75,000 a year) or years (58), as the
  // parameter says
  value         Decimal            @db.Decimal(12, 4)
  // the notification or section it comes from, e.g. "S.O. 5109(E), 17 Sep 2026" - for the CA's check
  reference     String
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   Int                @map("created_by_id")
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById   Int                @map("updated_by_id")

  @@unique([parameter, effectiveFrom])
  @@map("statutory_rates")
}

enum StatutoryParameter {
  // EPF / EPS / EDLI: percent of the PF wages; the wage ceiling in rupees a month; the EPS age limit in years
  PF_EMPLOYEE_RATE
  PF_EMPLOYER_RATE
  EPS_RATE
  EDLI_RATE
  PF_WAGE_CEILING
  EPS_AGE_LIMIT
  // ESIC: percent of the ESI wages; the coverage ceilings in rupees a month (persons with disabilities: higher)
  ESIC_EMPLOYEE_RATE
  ESIC_EMPLOYER_RATE
  ESIC_WAGE_CEILING
  ESIC_WAGE_CEILING_DISABLED
  // income tax, new regime, by tax year: rupees a year; the cess in percent; above the surcharge limit TDS is typed
  TAX_STANDARD_DEDUCTION
  TAX_REBATE_INCOME_LIMIT
  TAX_REBATE_MAX
  TAX_CESS_RATE
  TAX_SURCHARGE_FROM

  @@map("statutory_parameter")
}

// Professional tax of a State from a date: the month's tax by the month's earned gross. A State with no professional
// tax gets one nil slab (from 0, no upper limit, amount 0); a State with no slab at all holds its people.
model ProfessionalTaxSlab {
  id            Int      @id @default(autoincrement())
  // the work location's State, as WorkLocation.stateCode (e.g. WB)
  stateCode     String   @map("state_code") @db.Char(2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  // only for this gender (Maharashtra's slab for women); empty = everyone else
  gender        Gender?
  // the month's earned gross from .. to, whole rupees, both included; to empty = no upper limit
  wagesFrom     Int      @map("wages_from")
  wagesTo       Int?     @map("wages_to")
  // the month's tax, whole rupees
  amount        Int
  // a pay month (1-12) with another amount, to reach the yearly cap (Karnataka, Maharashtra: February 300)
  specialMonth  Int?     @map("special_month") @db.SmallInt
  specialAmount Int?     @map("special_amount")
  reference     String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   Int      @map("created_by_id")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById   Int      @map("updated_by_id")

  @@index([stateCode, effectiveFrom])
  @@map("professional_tax_slabs")
}

// Labour welfare fund of a State from a date: the employee's and the employer's amount, deducted in the pay months
// listed (West Bengal: June and December). A State with no fund gets a nil row (0 and 0); no row at all holds its people.
model LabourWelfareRate {
  id             Int      @id @default(autoincrement())
  stateCode      String   @map("state_code") @db.Char(2)
  effectiveFrom  DateTime @map("effective_from") @db.Date
  employeeAmount Decimal  @map("employee_amount") @db.Decimal(8, 2)
  employerAmount Decimal  @map("employer_amount") @db.Decimal(8, 2)
  // the pay months (1-12) it is deducted in; empty = every month
  months         Int[]    @db.SmallInt
  reference      String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    Int      @map("created_by_id")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById    Int      @map("updated_by_id")

  @@unique([stateCode, effectiveFrom])
  @@map("labour_welfare_rates")
}

// The income-tax rate of a regime for a tax year (from 1 April) on the taxable income between from and to
model IncomeTaxSlab {
  id          Int       @id @default(autoincrement())
  regime      TaxRegime
  taxYearFrom DateTime  @map("tax_year_from") @db.Date
  // whole rupees a year; to empty = no upper limit
  incomeFrom  Int       @map("income_from")
  incomeTo    Int?      @map("income_to")
  ratePercent Decimal   @map("rate_percent") @db.Decimal(5, 2)
  reference   String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById Int       @map("created_by_id")
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById Int       @map("updated_by_id")

  @@unique([regime, taxYearFrom, incomeFrom])
  @@map("income_tax_slabs")
}

// Income-tax regime (Income-tax Act 2025 s.202: NEW by default; OLD by the employee's choice)
enum TaxRegime {
  NEW
  OLD

  @@map("tax_regime")
}

// What an employee earned and had deducted as income tax earlier in a tax year, outside this system (greytHR before the
// go-live, or a previous employer - Form 122): the monthly TDS spreads the rest of the year's tax over the months left.
// Entered by someone with Payroll Edit covering the employee's company, never for themselves.
model TaxOpeningBalance {
  id              Int      @id @default(autoincrement())
  employeeId      Int      @map("employee_id")
  // 1 April of the tax year
  taxYearFrom     DateTime @map("tax_year_from") @db.Date
  // the figures cover the tax year up to and including this pay month (the first day of the month) - runs of later pay
  // months in this system are added on top
  throughPayMonth DateTime @map("through_pay_month") @db.Date
  // whole rupees
  taxableIncome   Int      @map("taxable_income")
  taxDeducted     Int      @map("tax_deducted")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById     Int      @map("created_by_id")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById     Int      @map("updated_by_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, taxYearFrom])
  @@map("tax_opening_balances")
}

// --- Stage 5 (approved by the user 2026-11-27): review, approval and finalising ---

// Something about a person in a run that is not an error but must be looked at before the run is sent - worked out from
// the run and the employee's records each time (payroll/checks); the texts never carry an amount
enum PayWarning {
  // this month's payment
  NET_ZERO
  NO_BANK_ACCOUNT
  // a salary account without its IFSC or account holder
  BANK_INCOMPLETE
  // net pay more than PayrollSetting.bigChangePercent above / below last month's run
  BIG_CHANGE
  // leaves in or before the pay period: full and final (wages within 2 working days)
  LEAVING
  ABSENT_THROUGHOUT
  // the same item and amount typed twice
  DUPLICATE_INPUT
  // an input above the person's monthly gross
  LARGE_INPUT
  // statutory, later months
  NO_PAN
  // a PF member: the PF return cannot be filed for them
  NO_UAN
  // a PF member: UAN KYC
  NO_AADHAAR
  // ESIC covered with no IP number
  NO_ESIC_NUMBER
  // not "PF applicable" though the PF wages are within the ceiling
  NO_PF_UNDER_CEILING
  // joined in this tax year with no opening tax figures (a previous employer's income is unknown)
  NO_TAX_OPENING
  // reaches the EPS age limit within PayrollSetting.epsAgeSoonMonths
  EPS_AGE_SOON

  @@map("pay_warning")
}

// One warning about one person of a run, acknowledged with a comment by someone with Payroll Edit covering the whole
// company (never their own) - every warning of a run must be acknowledged before it can be sent. The row's createdAt /
// createdById are when and by whom it was acknowledged (updatedAt / ById when the comment was changed). A person's
// acknowledgements are removed when their inputs change, and before a refresh drops the person (never silently by a
// cascade: the deletion stays in the change history). Recorded in the change history (a person's decision).
model PayrollRunAcknowledgement {
  id                   Int        @id @default(autoincrement())
  payrollRunEmployeeId Int        @map("payroll_run_employee_id")
  warning              PayWarning
  // why it is fine, or what was done - required
  comment              String
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById          Int        @map("created_by_id")
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById          Int        @map("updated_by_id")

  runEmployee PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunEmployeeId, warning])
  @@map("payroll_run_acknowledgements")
}

// Payroll settings for the whole group (one row, id 1 - approved by the user 2026-11-27: "nothing should be hardcoded").
// Until it is saved the defaults below apply (payroll/statutory). Edited on Payroll › Statutory settings with Payroll
// Edit for every company; changes count from the next "Work out pay".
model PayrollSetting {
  id                 Int      @id
  // monthly TDS counts earlier months of the tax year from their runs: false = finalised runs only (a month whose run is
  // not finalised is estimated at the current salary with nothing deducted); true = draft runs too
  tdsCountsDraftRuns Boolean  @default(false) @map("tds_counts_draft_runs")
  // the BIG_CHANGE warning: net pay more than this % above or below last month's run of the same company
  bigChangePercent   Int      @default(20) @map("big_change_percent") @db.SmallInt
  // the EPS_AGE_SOON warning: reaches the EPS age limit within this many months
  epsAgeSoonMonths   Int      @default(2) @map("eps_age_soon_months") @db.SmallInt
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById        Int      @map("created_by_id")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById        Int      @map("updated_by_id")

  @@map("payroll_settings")
}
