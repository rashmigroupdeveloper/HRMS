# Copy to .env for local development. NEVER commit real values (docs/02 §2).
#
#   cp .env.example .env
#
# Or run from repo root:
#   bash scripts/setup-local-env.sh

# --- Runtime (required now) ---
NODE_ENV=development
PORT=5100
LOG_LEVEL=info

# --- Database (required now) ---
# One-time Postgres setup (as a superuser):
#   CREATE USER hrms WITH PASSWORD 'hrms_local_dev';
#   CREATE DATABASE hrms OWNER hrms;
#   GRANT ALL PRIVILEGES ON DATABASE hrms TO hrms;
DATABASE_URL=postgres://hrms:hrms_local_dev@localhost:5432/hrms

# Integration checks require an explicit target; never fall back to DATABASE_URL.
# CI uses its dedicated *_test database. For a sponsor-approved, test-only local
# hrms database, explicitly set the same local connection plus the exact name:
# TEST_DATABASE_URL=postgres://hrms:hrms_local_dev@localhost:5432/hrms
# LOCAL_TEST_DATABASE_NAME=hrms
# The local exception is accepted only on loopback while NODE_ENV=test.

# --- Auth (required now — Stage 0.4) ---
# JWT signing secret — min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# --- SSO / ATS integration (Phase 1+) ---
# ATS_JWT_PUBLIC_KEY=
# CORS_ORIGIN=http://localhost:5173

# --- Email (Stage 0.4 notifications) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hrms@rashmigroup.com

# --- Object storage (Phase 3.5 — SeaweedFS per docs/14 §4) ---
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=hrms-uploads

# --- Production-only notes ---
# On the WHM server: file lives outside web root, chmod 600, NODE_ENV=production always set on PM2 (docs/02 §2; VBMS/EMS lesson).

# Kent CamAttendance feed (docs/integrations/KENT.md). Nothing set = feed not attached.
# Webhook (real time). The URL to give Kent: https://<host>/api/integrations/kent/webhook/<KENT_WEBHOOK_TOKEN>
# KENT_WEBHOOK_TOKEN=            # openssl rand -hex 24
# KENT_WEBHOOK_ALLOW_IPS=        # optional, comma-separated Kent egress IPs
# KENT_WEBHOOK_HEADER= / KENT_WEBHOOK_HEADER_VALUE=   # only if Kent agrees to send a shared header
# Pull / catch-up: KENT_MODE=api | db | csv (inferred from which of KENT_BASE_URL / KENT_DB_URL / KENT_CSV_DIR is set)
# KENT_BASE_URL=https://kent.example
# KENT_AUTH=header               # header | bearer | query | login | none
# KENT_API_KEY=
# KENT_PULL_PATH=/punches  KENT_PAGING=cursor  KENT_ITEMS_PATH=items  KENT_REREAD_DAYS=3
# KENT_DB_URL=postgres://reader@host/db  KENT_DB_TABLE=public.kent_logs  KENT_DB_COLUMNS={"employeeNo":"EmpCode","time":"LogTime","device":"DeviceName"}
# KENT_CSV_DIR=/srv/kent-drop    KENT_CSV_ARCHIVE_DIR=/srv/kent-drop/processed
# KENT_DEFAULT_OFFSET=+05:30
# KENT_DEVICE_MAP={"1001":"Seamless-Plant_S4"}
# STORAGE_DIR=/var/hrms/storage
# SMTP_HOST=
