# Copy to .env for local development. NEVER commit real values (docs/02 §2).
#
#   cp .env.example .env
#
# Or run from repo root:
#   bash scripts/setup-local-env.sh

# --- Runtime (required now) ---
NODE_ENV=development
PORT=5100
LOG_LEVEL=info

# --- Database (required now) ---
# One-time Postgres setup (as a superuser):
#   CREATE USER hrms WITH PASSWORD 'hrms_local_dev';
#   CREATE DATABASE hrms OWNER hrms;
#   GRANT ALL PRIVILEGES ON DATABASE hrms TO hrms;
DATABASE_URL=postgres://hrms:hrms_local_dev@localhost:5432/hrms
# Required by Vitest. The `_test` suffix is enforced before any test loads.
TEST_DATABASE_URL=postgres://hrms:hrms_local_dev@localhost:5432/hrms_test

# --- Auth (required now — Stage 0.4) ---
# JWT signing secret — min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# --- SSO / ATS integration (Phase 1+) ---
# ATS_JWT_PUBLIC_KEY=
# CORS_ORIGIN=http://localhost:5173

# --- Email (Stage 0.4 notifications) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hrms@rashmigroup.com

# --- Object storage (Phase 3.5 — SeaweedFS per docs/14 §4) ---
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=hrms-uploads

# --- Production-only notes ---
# On the WHM server: file lives outside web root, chmod 600, NODE_ENV=production always set on PM2 (docs/02 §2; VBMS/EMS lesson).

# --- Biometric feed (ATT-01 / P0-T01) ---
# `mock` generates deterministic synthetic punches for every active employee.
# It is the DEFAULT for local development and is REFUSED in production: those
# punches land in the append-only att.swipe_events and drive OT and pay.
# Set to `kent` once the real feed is configured (sponsor decision D15).
ATT_CONNECTOR=mock

# --- Rate limiting (NFR-03) ---
# Two layers: a tight per-(address+identifier) ceiling stops brute force on one
# account; a generous per-address ceiling allows a plant's 09:00 login rush,
# since ~1,066 employees share a handful of egress addresses. A tight per-address
# limit would be the limiter causing the outage it prevents.
# RATE_LIMIT_AUTH_PER_IDENTIFIER=10   # per 15 min
# RATE_LIMIT_AUTH_PER_ADDRESS=300     # per 15 min
# RATE_LIMIT_INTAKE_PER_ADDRESS=10    # per hour (anonymous POSH / whistleblower)
# RATE_LIMIT_GLOBAL_PER_ADDRESS=600   # per minute
