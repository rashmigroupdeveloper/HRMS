# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5200

# PostgreSQL connection for the new HRMS database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hrms_new

# Database for the automated tests (npm run test): its name must end in _test, and never point it at the app database -
# the tests add their own data to it on every run (nothing is deleted). Created and migrated by the tests.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hrms_new_test

# Frontend origin allowed to call the API (comma-separated for several)
CORS_ORIGIN=http://localhost:5180

# Encrypts Aadhaar / PAN / passport / bank account numbers (32 random bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK IT UP - losing it makes that data unreadable. Use a different key per environment.
DATA_ENCRYPTION_KEY=

# Folder for uploaded documents (relative to backend/ or absolute). Back it up together with the database.
STORAGE_DIR=storage

# Address of the web app as candidates open it (links in e-mails: APP_URL/offer/<token>, APP_URL/joining-form/<token>)
APP_URL=http://localhost:5180

# Outgoing e-mail (offer letters, one-time codes). Leave SMTP_HOST commented out to only write e-mails to the server log.
# SMTP_HOST=
SMTP_PORT=587
# true = TLS from the start (port 465); false = STARTTLS (port 587)
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=HRMS <no-reply@localhost>
