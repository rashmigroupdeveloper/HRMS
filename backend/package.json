{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#core/*": {
      "types": "./src/core/*.ts",
      "development": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "#shared/*": {
      "types": "./src/shared/*.ts",
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#modules/*": {
      "types": "./src/modules/*/index.ts",
      "development": "./src/modules/*/index.ts",
      "default": "./dist/modules/*/index.js"
    }
  },
  "scripts": {
    "dev": "node --conditions=development --env-file-if-exists=.env --watch --watch-preserve-output --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node --conditions=development --env-file-if-exists=.env --watch --watch-preserve-output --import tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "import:old-hrms": "node --conditions=development --import tsx scripts/import-old-hrms.ts",
    "import:vbms": "node --conditions=development --import tsx scripts/import-vbms-masters.ts",
    "set-password": "node --conditions=development --import tsx scripts/set-password.ts",
    "create-admin": "node --conditions=development --import tsx scripts/create-admin.ts",
    "create-role-employees": "node --conditions=development --import tsx scripts/create-role-employees.ts",
    "rename-stored-files": "node --conditions=development --import tsx scripts/rename-stored-files.ts",
    "backfill-job-records": "node --conditions=development --import tsx scripts/backfill-job-records.ts",
    "check:api-tracker": "node --conditions=development --import tsx scripts/check-api-tracker.ts",
    "check:data-access": "node --conditions=development --import tsx scripts/check-data-access.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/tinos": "^5.3.0",
    "@orpc/server": "^1.15.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
